<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelSurvey.App">
    <Application.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="#183A38" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="TextColor" Value="#126B63" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="#D8E5DF" />
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="Padding" Value="18" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="#183A38" />
                <Setter Property="PlaceholderColor" Value="#6C817D" />
                <Setter Property="BackgroundColor" Value="#F2F7F4" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="#183A38" />
                <Setter Property="PlaceholderColor" Value="#6C817D" />
                <Setter Property="BackgroundColor" Value="#F2F7F4" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="#183A38" />
                <Setter Property="TitleColor" Value="#6C817D" />
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="TextColor" Value="#183A38" />
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="TextColor" Value="#183A38" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="#126B63" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="MinimumHeightRequest" Value="50" />
                <Setter Property="Padding" Value="14,12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
